{
  //"urls": "http://*:51000/;https://*:51001",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:50000"
      } //,
      //"Https": {
      //  "Url": "https://*:51001",
      //  "Certificate": {
      //    "Path": "certificate.pfx",
      //    "Password": "onit!2018",
      //    "AllowInvalid": "true"
      //  }
      //}
    }
  },
  "ConnectionStrings": {
    "BBDomConnection": "DataSource=bb_dom.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwExceptions": false,
    "internalLogLevel": "Off",
    "internalLogFile": "c:\\temp\\nlog-internal.log",
    "targets": {
      "file": {
        "type": "File",
        "fileName": "c:\\Log\\BBDom.Web\\debug.log",
        "layout": "${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}",
        "archiveEvery": "Day",
        "archiveFileName": "c:\\Log\\BBDom.Web\\debug.txt",
        "archiveSuffixFormat": "{1:yyyy-MM-dd}",
        "maxArchiveFiles": 10
      },
      "console": {
        "type": "Console",
        "layout": "${date} | ${level} | ${processname} | ${message} | ${exception:format=ToString,StackTrace} ${newline}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "file,console"
      }
    ]
  }
}
